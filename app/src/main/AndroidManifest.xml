<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络（保留：自更新走 GitHub） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 包查询 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 自更新安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 公益版：删除 AD_ID / ACCESS_ADSERVICES 广告归因权限 -->

    <!-- 自定义权限：daemon Binder 推回 App 用（INTERACT_ACROSS_USERS_FULL 由 daemon 持） -->
    <permission
        android:name="com.xingkong.monitor.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.xingkong.monitor.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name=".XingkongApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xingkong"
        tools:targetApi="34">

        <!-- 主 Activity（无 payment deeplink，公益版去支付） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机自启 -->
        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- BinderProvider：daemon 推 Binder 回 App -->
        <provider
            android:name=".ipc.BinderProvider"
            android:authorities="com.xingkong.monitor.binderProvider"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.xingkong.monitor.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FPS 记录前台服务（specialUse） -->
        <service
            android:name=".tile.FpsRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动通过快捷设置磁贴启动的前台应用帧率持续记录" />
        </service>

        <!-- 快捷磁贴 -->
        <service
            android:name=".tile.FpsRecordTileService"
            android:label="@string/tile_fps_record"
            android:icon="@drawable/ic_tile_fps"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 进程记录前台服务 -->
        <service
            android:name=".core.service.ProcessRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动启动的本地进程性能持续记录" />
        </service>

        <!-- 实时通知服务 -->
        <service
            android:name=".feature.realtimenotification.RealtimeNotificationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动启用的 App 侧实时性能通知" />
        </service>

        <!-- 实时通知 Overlay Receiver（daemon 调用） -->
        <receiver
            android:name=".overlay.notification.RealtimeNotificationOverlayReceiver"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:exported="true" />

        <!-- 无障碍服务：监听前台 App 切换（FPS 记录自动开始/停止） -->
        <service
            android:name=".feature.realtimenotification.RealtimeNotificationAccessibilityService"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 应用组件快捷方式 Activity -->
        <activity
            android:name=".feature.appmanager.ComponentShortcutActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <receiver
            android:name=".feature.appmanager.ComponentShortcutPinnedReceiver"
            android:exported="false" />

        <!-- 自更新下载完成 Receiver -->
        <receiver
            android:name=".feature.settings.update.AppDownloader$DownloadCompleteReceiver"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
